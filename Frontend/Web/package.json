{
  "name": "cloud-gateway",
  "homepage": "https://gocloudlaunch.com",
  "version": "1.0.42",
  "private": true,
  "dependencies": {
    "@tailwindcss/cli": "^4.0.14",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "file-saver": "^2.0.5",
    "firebase": "^11.5.0",
    "lucide-react": "^0.510.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "zustand": "^5.0.4"
  },
  "scripts": {
    "start": "concurrently \"cross-env BROWSER=none react-scripts start\" \"npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --watch\"",
    "prebuild": "npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --minify",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm version patch --no-git-tag-version && npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --minify && npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/qrcode": "^1.5.5",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "http-proxy-middleware": "^2.0.9",
    "knip": "^6.27.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.14"
  }
}
