# Copy to Secrets/release.env for cloudgateway-release build. Environment
# variables with the same names override this file
# Go to the Firebase project > Project Settings, then copy apiKey and projectId
# from the web app's firebaseConfig. They are public identifiers, not secrets
CLOUDGATEWAY_FIREBASE_API_KEY=
CLOUDGATEWAY_FIREBASE_PROJECT_ID=
CLOUDGATEWAY_FIREBASE_DATABASE_ID=(default)
